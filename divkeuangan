    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyA9kUlC-08i_ZLpDUrnkcskh6zzLpbMsRo",
            authDomain: "divisi-keuangan-store.firebaseapp.com",
            projectId: "divisi-keuangan-store",
            storageBucket: "divisi-keuangan-store.firebasestorage.app",
            messagingSenderId: "145473393451",
            appId: "1:145473393451:web:2a9badafe5e74c265fab6e",
            measurementId: "G-P18ZV7PZ2N"
        };

        firebase.initializeApp(firebaseConfig);
        const db = firebase.firestore();

        let isAdmin = localStorage.getItem('isAdmin') === 'true';
        let currentAdminPass = localStorage.getItem('adminPass') || 'admin';
        let products = [], orders = [], transactions = [];
        let cart = JSON.parse(localStorage.getItem('cart')) || [];

        const formatRp = (num) => 'Rp ' + parseInt(num).toLocaleString('id-ID');
        const toggleElement = (id) => document.getElementById(id).classList.toggle('hidden');

        window.onload = () => {
            setupFirebaseListeners();
            updateUIVisibility();
            renderCart();
        };

        function setupFirebaseListeners() {
            db.collection("products").onSnapshot((snapshot) => {
                products = [];
                snapshot.forEach((doc) => products.push({ id: doc.id, ...doc.data() }));
                renderPublicProducts();
                if(isAdmin) renderAdminProducts();
            }, (error) => {
                console.error("Firebase Error:", error);
                document.getElementById('public-products-grid').innerHTML = `<div class="col-span-full text-center py-10 text-red-500 font-bold">Gagal terhubung ke Database. Pastikan Aturan Firestore (Rules) diatur menjadi 'allow read, write: if true;'.</div>`;
            });

            db.collection("orders").orderBy("timestamp", "desc").onSnapshot((snapshot) => {
                orders = [];
                snapshot.forEach((doc) => orders.push({ id: doc.id, ...doc.data() }));
                if(isAdmin) renderAdminOrders();
            }, (err) => console.log("Gagal memuat orders:", err));

            db.collection("transactions").orderBy("timestamp", "desc").onSnapshot((snapshot) => {
                transactions = [];
                snapshot.forEach((doc) => transactions.push({ id: doc.id, ...doc.data() }));
                if(isAdmin) { renderAdminTransactions(); calculateDashboard(); }
            }, (err) => console.log("Gagal memuat transaksi:", err));
        }

        function renderPublicProducts() {
            const grid = document.getElementById('public-products-grid');
            if (products.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-10 text-gray-500">Belum ada produk. Silakan tambahkan dari panel admin.</div>`;
                return;
            }
            grid.innerHTML = products.map(p => `
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition">
                    <div class="h-48 overflow-hidden bg-gray-100 relative">
                        <img src="${p.image}" class="w-full h-full object-cover">
                        <span class="absolute top-2 left-2 bg-olive text-white text-[10px] px-2 py-1 rounded-full uppercase">${p.category}</span>
                        ${p.stock <= 0 ? `<div class="absolute inset-0 bg-white/70 flex items-center justify-center"><span class="bg-red-500 text-white font-bold px-4 py-1 rounded">HABIS</span></div>` : ''}
                    </div>
                    <div class="p-4">
                        <h3 class="font-bold text-gray-800 text-lg mb-1 truncate">${p.name}</h3>
                        <p class="text-maroon font-bold text-lg mb-3">${formatRp(p.price)}</p>
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-gray-500">Stok: ${p.stock}</span>
                            <button onclick="addToCart('${p.id}')" ${p.stock <= 0 ? 'disabled' : ''} class="bg-olive hover:bg-[#2d331e] disabled:bg-gray-300 text-white p-2 rounded-full w-8 h-8 flex items-center justify-center"><i class="fas fa-plus text-sm"></i></button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function addToCart(productId) {
            const product = products.find(p => p.id === productId);
            if (!product || product.stock <= 0) return;
            const existing = cart.find(item => item.id === productId);
            if (existing) {
                if(existing.qty < product.stock) existing.qty += 1;
            } else {
                cart.push({ id: product.id, name: product.name, price: product.price, image: product.image, qty: 1 });
            }
            saveCart(); renderCart();
        }
        function removeFromCart(index) { cart.splice(index, 1); saveCart(); renderCart(); }
        function saveCart() { localStorage.setItem('cart', JSON.stringify(cart)); }
        function renderCart() {
            const container = document.getElementById('cart-items-container');
            let totalQty = 0, totalPrice = 0;
            if (cart.length === 0) {
                container.innerHTML = `<div class="text-center text-gray-400 py-10">Keranjang kosong</div>`;
            } else {
                container.innerHTML = cart.map((item, i) => {
                    totalQty += item.qty; totalPrice += (item.price * item.qty);
                    return `<div class="flex items-center gap-3 bg-white p-2 border rounded-lg">
                        <img src="${item.image}" class="w-16 h-16 object-cover rounded">
                        <div class="flex-1">
                            <h4 class="font-bold text-sm text-gray-800 line-clamp-1">${item.name}</h4>
                            <p class="text-maroon text-sm font-semibold">${formatRp(item.price)}</p>
                            <p class="text-xs font-bold mt-1">Qty: ${item.qty}</p>
                        </div>
                        <button onclick="removeFromCart(${i})" class="text-red-400 p-2"><i class="fas fa-trash"></i></button>
                    </div>`;
                }).join('');
            }
            document.getElementById('cart-count').innerText = totalQty;
            document.getElementById('cart-total').innerText = formatRp(totalPrice);
        }

        function toggleCart() { document.getElementById('cart-drawer').classList.toggle('hidden'); }
        function openCheckoutModal() { 
            if(cart.length === 0) return alert('Keranjang kosong!');
            toggleCart(); document.getElementById('checkout-modal').classList.remove('hidden'); 
        }
        function closeCheckoutModal() { document.getElementById('checkout-modal').classList.add('hidden'); }
        function closeSuccessModal() { document.getElementById('success-modal').classList.add('hidden'); }

        function submitOrder(e) {
            e.preventDefault();
            const orderData = {
                name: document.getElementById('co-name').value,
                wa: document.getElementById('co-wa').value,
                address: document.getElementById('co-address').value,
                total: cart.reduce((sum, item) => sum + (item.price * item.qty), 0),
                items: cart,
                timestamp: firebase.firestore.FieldValue.serverTimestamp()
            };

            db.collection("orders").add(orderData).then(() => {
                cart = []; saveCart(); renderCart();
                closeCheckoutModal(); 
                document.getElementById('success-modal').classList.remove('hidden');
                e.target.reset();
            }).catch(error => {
                alert('Gagal! Pastikan aturan baca/tulis Firestore sudah terbuka: ' + error.message);
            });
        }

        function openLoginModal() { document.getElementById('login-modal').classList.remove('hidden'); }
        function closeLoginModal() { document.getElementById('login-modal').classList.add('hidden'); document.getElementById('login-error').classList.add('hidden'); }
        function handleLogin(e) {
            e.preventDefault();
            if (document.getElementById('login-user').value === 'admin' && document.getElementById('login-pass').value === currentAdminPass) {
                isAdmin = true; localStorage.setItem('isAdmin', 'true');
                closeLoginModal(); updateUIVisibility(); switchAdminTab('dashboard');
            } else document.getElementById('login-error').classList.remove('hidden');
        }
        function logout() { isAdmin = false; localStorage.removeItem('isAdmin'); updateUIVisibility(); }
        function updateUIVisibility() {
            if (isAdmin) {
                document.getElementById('login-btn').classList.add('hidden');
                document.getElementById('logout-btn').classList.remove('hidden');
                document.getElementById('cart-btn').classList.add('hidden');
                document.getElementById('admin-nav').classList.remove('hidden');
                document.getElementById('admin-nav').classList.add('flex');
                navigateTo('admin-view');
            } else {
                document.getElementById('login-btn').classList.remove('hidden');
                document.getElementById('logout-btn').classList.add('hidden');
                document.getElementById('cart-btn').classList.remove('hidden');
                document.getElementById('admin-nav').classList.add('hidden');
                document.getElementById('admin-nav').classList.remove('flex');
                navigateTo('public-view');
            }
        }
        function navigateTo(v) { document.querySelectorAll('.view-section').forEach(el => el.classList.add('hidden-view')); document.getElementById(v).classList.remove('hidden-view'); }
        function switchAdminTab(t) { document.querySelectorAll('.admin-content').forEach(el => el.classList.add('hidden-view')); document.getElementById(`tab-${t}`).classList.remove('hidden-view'); document.querySelectorAll('.admin-tab').forEach(el => el.classList.remove('tab-active')); event.currentTarget.classList.add('tab-active'); }

        function saveProduct(e) {
            e.preventDefault();
            db.collection("products").add({
                name: document.getElementById('prod-name').value,
                category: document.getElementById('prod-category').value,
                price: parseInt(document.getElementById('prod-price').value),
                stock: parseInt(document.getElementById('prod-stock').value),
                image: document.getElementById('prod-image').value,
                timestamp: firebase.firestore.FieldValue.serverTimestamp()
            }).then(() => {
                document.getElementById('productForm').reset();
                toggleElement('form-tambah-produk');
            }).catch(err => alert("Gagal Simpan! Error: " + err.message));
        }

        function deleteProduct(id) {
            if(confirm('Hapus produk ini?')) {
                db.collection("products").doc(id).delete()
                .catch(err => alert("Gagal menghapus! Error: " + err.message));
            }
        }

        function renderAdminProducts() {
            document.getElementById('admin-products-table').innerHTML = products.map(p => `
                <tr>
                    <td class="px-6 py-4 whitespace-nowrap"><div class="flex items-center"><img src="${p.image}" class="h-10 w-10 object-cover mr-3"><span class="font-medium">${p.name}</span></div></td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${p.category}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold">${formatRp(p.price)}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm">${p.stock}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-right"><button onclick="deleteProduct('${p.id}')" class="text-red-600 hover:text-red-900"><i class="fas fa-trash"></i></button></td>
                </tr>
            `).join('');
        }

        function renderAdminOrders() {
            const b = document.getElementById('order-badge');
            b.classList[orders.length > 0 ? 'remove' : 'add']('hidden');
            b.innerText = orders.length;

            document.getElementById('admin-orders-table').innerHTML = orders.map(o => `
                <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-bold">${o.name}<br><a href="https://wa.me/${o.wa}" target="_blank" class="text-green-600 text-xs"><i class="fab fa-whatsapp"></i> ${o.wa}</a></td>
                    <td class="px-6 py-4 text-sm max-w-xs truncate" title="${o.address}">${o.address}</td>
                    <td class="px-6 py-4 text-sm">${o.items.map(i => `${i.name} (${i.qty}x)`).join('<br>')}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-maroon">${formatRp(o.total)}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm space-x-2">
                        <button onclick="acceptOrder('${o.id}')" class="bg-green-100 text-green-700 px-3 py-1 rounded">Terima</button>
                        <button onclick="rejectOrder('${o.id}')" class="bg-red-100 text-red-700 px-3 py-1 rounded">Tolak</button>
                    </td>
                </tr>`).join('');
        }

        async function acceptOrder(id) {
            if(!confirm('Terima pesanan ini? Stok akan otomatis dikurangi dan dicatat ke Pemasukan.')) return;
            const order = orders.find(o => o.id === id);
            try {
                for(let item of order.items) {
                    const doc = await db.collection("products").doc(item.id).get();
                    if(doc.exists) await db.collection("products").doc(item.id).update({ stock: doc.data().stock - item.qty });
                }
                await db.collection("transactions").add({ type: "Pemasukan", desc: `Penjualan Online: ${order.name}`, amount: order.total, timestamp: firebase.firestore.FieldValue.serverTimestamp() });
                await db.collection("orders").doc(id).delete();
                alert('Pesanan Diterima!');
            } catch (err) { alert("Error Firebase: " + err.message); }
        }

        function rejectOrder(id) { if(confirm('Tolak pesanan?')) db.collection("orders").doc(id).delete(); }

        function saveTransaction(e) {
            e.preventDefault();
            db.collection("transactions").add({
                type: document.getElementById('trx-type').value,
                desc: document.getElementById('trx-desc').value,
                amount: parseInt(document.getElementById('trx-amount').value),
                timestamp: firebase.firestore.FieldValue.serverTimestamp()
            }).then(() => { document.getElementById('form-tambah-transaksi').classList.add('hidden'); e.target.reset(); });
        }

        function renderAdminTransactions() {
            document.getElementById('admin-trx-table').innerHTML = transactions.map(t => {
                const isInc = t.type === 'Pemasukan';
                return `<tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${t.timestamp ? new Date(t.timestamp.toDate()).toLocaleDateString('id-ID') : 'Baru'}</td>
                    <td class="px-6 py-4"><span class="px-2 py-1 text-xs rounded-full ${isInc ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">${t.type}</span></td>
                    <td class="px-6 py-4 text-sm">${t.desc}</td>
                    <td class="px-6 py-4 text-sm font-bold text-right ${isInc ? 'text-green-600' : 'text-red-600'}">${formatRp(t.amount)}</td>
                    <td class="px-6 py-4 text-right"><button onclick="db.collection('transactions').doc('${t.id}').delete()" class="text-red-500"><i class="fas fa-trash"></i></button></td>
                </tr>`;
            }).join('');
        }

        function calculateDashboard() {
            let pemasukan = 0, pengeluaran = 0;
            transactions.forEach(t => { t.type === 'Pemasukan' ? pemasukan += t.amount : pengeluaran += t.amount; });
            document.getElementById('dash-pemasukan').innerText = document.getElementById('lap-pemasukan').innerText = formatRp(pemasukan);
            document.getElementById('dash-pengeluaran').innerText = document.getElementById('lap-pengeluaran').innerText = formatRp(pengeluaran);
            document.getElementById('dash-saldo').innerText = document.getElementById('lap-saldo').innerText = formatRp(pemasukan - pengeluaran);
        }

        function changePassword(e) {
            e.preventDefault();
            if(document.getElementById('old-pass').value !== currentAdminPass) return alert('Password lama salah!');
            currentAdminPass = document.getElementById('new-pass').value;
            localStorage.setItem('adminPass', currentAdminPass);
            alert('Password diubah!'); e.target.reset();
        }
    </script>
</body>
</html>
